<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimension_8"
        android:layout_marginHorizontal="@dimen/dimension_4"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:gslCornerRadius="@dimen/dimension_24"
            app:gslStrokeWidth="@dimen/dimension_1"
            app:gslStartColor="@color/white"
            app:gslCenterColor="@color/white"
            app:gslEndColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1">
        <ImageView
                android:id="@+id/imgHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/home1"/>
        <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pony_maker"
                style="@style/single_marquee"
                android:fontFamily="@font/finger_paint_regular"
                android:textSize="@dimen/text_size_16"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/view"
                android:textColor="@color/black"
                android:layout_gravity="bottom"
                android:layout_marginBottom="@dimen/dimension_8"
                android:gravity="center"/>


    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
