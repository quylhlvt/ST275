<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dimension_10"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:layout_width="match_parent"
        android:background="@drawable/bg_item_home_shadown"
        android:layout_height="@dimen/dimension_0"
        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintDimensionRatio="2.8:0.71"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menuContainer"
        android:layout_width="match_parent"
        android:background="@drawable/bg_item_home"
        android:layout_height="@dimen/dimension_0"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="2.8:0.68">
        <com.anime.oc.characters.avatar.core.extention.OuterStrokeTextView2
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/pony_maker"
            android:fontFamily="@font/pacifico_regular"
            android:textSize="@dimen/text_size_26"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/view"
            android:textColor="@color/white"
            app:outerStrokeWidth="@dimen/dimension_2"
            app:outerStrokeColor="@color/app_color"
            android:layout_gravity="center"
            android:gravity="center"/>
        <View
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="2.8:0.08"
            android:id="@+id/view"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
