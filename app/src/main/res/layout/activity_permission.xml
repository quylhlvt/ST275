<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color4"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.anime.oc.characters.av.ui.onboarding.permission.PermissionActivity">
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dimension_1"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>


    <ImageView
        android:id="@+id/imgPermission"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginHorizontal="@dimen/dimension_46"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintVertical_bias="0"
        android:adjustViewBounds="true"
        android:src="@drawable/img_permission"
        app:layout_constraintBottom_toTopOf="@+id/view3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginVertical="@dimen/dimension_20"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />

<View
        android:id="@+id/view3"
        android:layout_width="@dimen/dimension_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
      android:layout_height="@dimen/dimension_0"
      app:layout_constraintDimensionRatio="3.28:1.28"
      app:layout_constraintBottom_toTopOf="@+id/tvContinue"
      android:layout_marginBottom="@dimen/dimension_30"/>

    <ScrollView
            android:id="@+id/scrollView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_20"
            android:scrollbars="none"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintTop_toBottomOf="@+id/imgPermission"
            app:layout_constraintBottom_toBottomOf="@+id/view3">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimension_20"
                android:orientation="vertical">

            <!-- btnStorage-->
            <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout

                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintDimensionRatio="3.28:0.56"
                    android:id="@+id/btnStorageStroker"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:gslCornerRadius="@dimen/dimension_18"
                    app:gslStrokeWidth="@dimen/dimension_2"
                    app:gslStartColor="@color/app_color"
                    app:gslCenterColor="@color/app_color"
                    app:gslEndColor="@color/app_color">

                <androidx.constraintlayout.widget.ConstraintLayout
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/btnStorage"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                    <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/black3"
                    />
                    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                            android:layout_width="match_parent"
                            android:layout_marginBottom="@dimen/dimension_4"
                            android:layout_height="match_parent"
                            app:gslStrokeWidth="@dimen/dimension_0"
                            app:gslCornerRadius="@dimen/dimension_17">
                        <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/white"
                        />
                    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

                    <TextView
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dimension_20"
                            android:gravity="center_vertical"
                            style="@style/single_marquee"
                            android:text="@string/storage"
                            android:textColor="@color/app_color"
                            android:fontFamily="@font/finger_paint_regular"
                            android:textSize="@dimen/text_size_16"/>

                    <ImageView
                            app:layout_constraintEnd_toEndOf="parent"
                            android:id="@+id/swPermission"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="@dimen/dimension_17_"
                            app:layout_constraintDimensionRatio="1"
                            android:layout_marginEnd="@dimen/dimension_16"
                            android:src="@drawable/ic_un_select_lang"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
            <Space
                    android:id="@+id/space"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.28:0.08"
                    app:layout_constraintTop_toBottomOf="@+id/btnStorageStroker"/>

            <!-- btnNotification-->
            <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="3.28:0.56"
                    app:layout_constraintTop_toBottomOf="@+id/space"
                    android:id="@+id/btnNotificationStroker"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:gslCornerRadius="@dimen/dimension_18"
                    app:gslStrokeWidth="@dimen/dimension_2"
                    app:gslStartColor="@color/app_color"
                    app:gslCenterColor="@color/app_color"
                    app:gslEndColor="@color/app_color">
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="match_parent"
                    android:background="@color/white"
                    android:layout_height="match_parent">
                <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/black3"
                />
                <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                        android:layout_width="match_parent"
                        android:layout_marginBottom="@dimen/dimension_4"
                        android:layout_height="match_parent"
                        app:gslStrokeWidth="@dimen/dimension_0"
                        app:gslCornerRadius="@dimen/dimension_17">
                    <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/white"
                    />
                </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

                <TextView
                        style="@style/single_marquee"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dimension_20"
                        android:fontFamily="@font/finger_paint_regular"
                        android:gravity="center_vertical"
                        android:text="@string/notification"
                        android:textColor="@color/app_color"
                        android:textSize="@dimen/text_size_16"
                        app:layout_constraintStart_toStartOf="parent"/>

                <ImageView
                        android:id="@+id/swNotification"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/dimension_16"
                        android:src="@drawable/ic_un_select_lang"
                        android:layout_marginVertical="@dimen/dimension_17_"
                        app:layout_constraintDimensionRatio="1"
                        app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <TextView
        android:id="@+id/tvContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimension_12"
        android:layout_marginBottom="@dimen/dimension_100"
        android:gravity="center"
        android:fontFamily="@font/finger_paint_regular"
        android:text="@string/continue_per"
        android:textSize="@dimen/text_size_20"
        android:textColor="@color/app_color2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
