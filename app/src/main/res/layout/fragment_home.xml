<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    tools:context="com.anime.oc.characters.avatar.ui.main.home.HomeFragment">
    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dimension_2"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contrain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dimension_50_"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">

        <ImageView
            android:id="@+id/title_home"
            android:layout_width="0dp"
            android:elevation="3dp"
            android:layout_marginTop="@dimen/dimension_20"
            android:layout_marginHorizontal="@dimen/dimension_10"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/img_title_home"
            app:layout_constraintDimensionRatio="3.42:2.36"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMainMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="@dimen/dimension_50_"
            android:layout_marginBottom="@dimen/dimension_82"
            android:elevation="1dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_home"
            app:layout_constraintVertical_bias="0">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_20"
                app:strokeWidth="@dimen/dimension_3"
                app:strokeColor="@color/app_color"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMainMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimension_10"
                    android:layout_marginHorizontal="@dimen/dimension_10"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/dimension_10"
                    app:strokeColor="@color/app_color3"
                    app:strokeWidth="@dimen/dimension_2">


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcvMain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:background="@drawable/bg_recycle_item_home"
                        android:paddingTop="@dimen/dimension_10"
                        android:overScrollMode="never"
                        android:paddingHorizontal="@dimen/dimension_10"
                        android:layout_marginTop="@dimen/dimension_40"
                        android:paddingBottom="@dimen/dimension_10"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_home_menu" />
                </com.google.android.material.card.MaterialCardView>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
                android:id="@+id/flNativeCollab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/dimension_100"
                app:layout_constraintBottom_toBottomOf="parent">

            <include layout="@layout/ads_shimmer_collap_native" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
