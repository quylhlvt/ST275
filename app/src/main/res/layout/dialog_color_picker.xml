<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
    >


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/contrainColor"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_width="match_parent"
                        android:layout_gravity="center"
                        android:layout_height="wrap_content"
                >
                    <View
                            android:id="@+id/view2"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="3.12:0.4"/>
                    <View
                            android:id="@+id/view3"
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="3.12:0.2"/>
                    <View android:layout_width="@dimen/dimension_0"
                          android:layout_height="@dimen/dimension_0"
                          app:layout_constraintStart_toStartOf="parent"
                          app:layout_constraintEnd_toEndOf="parent"
                          android:background="@drawable/bg_16_cosplay"
                          app:layout_constraintBottom_toBottomOf="@+id/linear1"
                          app:layout_constraintTop_toBottomOf="@+id/view3"/>
                    <TextView
                            android:layout_width="@dimen/dimension_0"
                            android:layout_height="@dimen/dimension_0"
                            app:layout_constraintDimensionRatio="1.56:0.4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/view2"
                            app:layout_constraintBottom_toBottomOf="@+id/view2"
                            android:textSize="@dimen/text_size_24"
                            android:fontFamily="@font/fluffy_cat"
                            android:elevation="@dimen/dimension_8"
                            android:text="@string/choose_color"
                            android:id="@+id/txtTille"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:background="@drawable/bg_instruction"/>

                    <ir.kotlin.quyhcolorpicker.QuylhColorPicker
                            android:id="@+id/colorPickerView"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dimension_150"
                            android:layout_marginHorizontal="@dimen/dimension_30"
                            android:layout_marginTop="@dimen/dimension_44"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/view3"/>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/dimension_6"
                            android:gravity="center"
                            android:id="@+id/linear1"
                            android:layout_marginTop="@dimen/dimension_5"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/colorPickerView">

                        <ir.kotlin.quyhcolorpicker.QuylhHueSlider
                                android:id="@+id/hueSlider"
                                android:paddingHorizontal="@dimen/dimension_6"
                                android:layout_marginHorizontal="@dimen/dimension_22"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dimension_34"/>

                        <!--                btnDone-->
                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/bg"
                                android:layout_marginTop="@dimen/dimension_16"
                                android:paddingBottom="@dimen/dimension_20"
                                android:layout_marginHorizontal="@dimen/dimension_20"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toBottomOf="@+id/txtContent">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/btnCancle"
                                    android:layout_width="@dimen/dimension_0"
                                    android:layout_height="@dimen/dimension_0"
                                    android:layout_marginHorizontal="@dimen/dimension_5"
                                    app:layout_constraintDimensionRatio="1.28:0.44"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/btnSave"
                                    app:layout_constraintTop_toTopOf="@+id/btnSave"
                                    app:strokeColor="@color/app_color2"
                                    app:strokeWidth="@dimen/dimension_1">

                                <ImageView
                                        android:id="@+id/imgCancleFor"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="fitXY"
                                        android:src="@drawable/btn_chossecolor"/>

                                <TextView
                                        android:id="@+id/txtCancle"
                                        style="@style/single_marquee"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/finger_paint_regular"
                                        android:gravity="center"
                                        android:text="@string/no"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/text_size_16"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/btnSave"
                                    android:layout_width="@dimen/dimension_0"
                                    android:layout_height="@dimen/dimension_0"
                                    android:layout_marginHorizontal="@dimen/dimension_5"
                                    app:layout_constraintDimensionRatio="1.28:0.44"

                                    app:layout_constraintEnd_toStartOf="@+id/btnCancle"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:strokeColor="@color/app_color2"
                                    app:strokeWidth="@dimen/dimension_1">


                                <ImageView
                                        android:id="@+id/imgSaveFor"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="fitXY"
                                        android:src="@drawable/btn_chossecolor2"/>

                                <TextView
                                        android:id="@+id/txtSave"
                                        style="@style/single_marquee"
                                        android:layout_width="@dimen/dimension_0"
                                        android:layout_height="@dimen/dimension_0"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toEndOf="@+id/imgSaveFor"
                                        app:layout_constraintTop_toTopOf="@+id/imgSaveFor"
                                        app:layout_constraintBottom_toBottomOf="@+id/imgSaveFor"
                                        android:fontFamily="@font/finger_paint_regular"
                                        android:gravity="center"
                                        android:text="@string/yes"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/text_size_16"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
