<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.anime.oc.characters.avatar.ui.onboarding.splash.SplashActivity">


    <TextView
        android:id="@+id/appCompatImageView4"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="wrap_content"
        android:textColor="@color/app_color2"
        android:text="@string/app_name"
        android:textSize="@dimen/text_size_32"
        android:gravity="center"
        android:fontFamily="@font/finger_paint_regular"
        style="@style/single_marquee"
        app:layout_constraintVertical_bias="1"
        android:layout_marginBottom="@dimen/dimension_16"
        android:src="@drawable/img_title_splash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/imageAvatar"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/imageAvatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dimension_70"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/image_splash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

    />



</androidx.constraintlayout.widget.ConstraintLayout>
