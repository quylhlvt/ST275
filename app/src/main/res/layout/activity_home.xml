<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_lang"
    tools:context="com.anime.oc.characters.avatar.ui.main.home.HomeActivity">
    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dimension_2"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <TextView
            android:id="@+id/txtTittleHome"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="wrap_content"
            android:textColor="@color/app_color2"
            android:text="@string/app_name"
            android:textSize="@dimen/text_size_32"
            android:gravity="center"
            android:fontFamily="@font/finger_paint_regular"
            style="@style/single_marquee"
            app:layout_constraintVertical_bias="1"
            android:layout_marginTop="@dimen/dimension_16"
            android:src="@drawable/img_title_splash"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvMain"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:clipToPadding="false"
            android:layout_marginTop="@dimen/dimension_8"
            android:layout_marginHorizontal="@dimen/dimension_12"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:itemCount="4"
            app:spanCount="2"
            tools:listitem="@layout/item_home_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtTittleHome"
    />



</androidx.constraintlayout.widget.ConstraintLayout>
