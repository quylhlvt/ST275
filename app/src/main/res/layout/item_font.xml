<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_marginEnd="@dimen/dimension_8"

    android:layout_height="match_parent">


    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
        android:id="@+id/frame"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        app:gslStrokeWidth="@dimen/dimension_2"
        app:cardBackgroundColor="@color/white"
        app:gslStartColor="@color/white"
        app:gslCenterColor="@color/white"
        app:gslEndColor="@color/white"
        app:gslCornerRadius="@dimen/dimension_150"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">



        <TextView
            android:id="@+id/tvFont"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@color/white"
            android:text="Aa"
            android:textColor="#7F7F7F"
            android:textSize="@dimen/text_size_12" />




    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
