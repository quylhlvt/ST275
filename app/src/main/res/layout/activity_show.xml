<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color4"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:context="com.anime.oc.characters.avatar.ui.main.show.ShowActivity">



    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar2"/>
    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_gravity="bottom"
        android:elevation="@dimen/dimension_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar"
        app:layout_constraintVertical_bias="0.0"

        tools:layout_editor_absoluteX="-16dp">

        <FrameLayout
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginHorizontal="@dimen/dimension_16"
            android:background="@android:color/transparent"
            android:elevation="@dimen/dimension_3"
            app:layout_constraintBottom_toTopOf="@+id/constrain2"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_20"
                app:strokeColor="@color/app_color5"
                app:strokeWidth="@dimen/dimension_2">

                <quylh.canvas.shadow.ShadowLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shadowBlur="@dimen/dimension_15"
                    app:shadowColor="@color/white"
                    app:shadowMode="inner"
                    app:shadowSpread="@dimen/dimension_0">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dimension_12">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="@dimen/dimension_8"
                            app:strokeColor="@color/app_color5"
                            app:strokeWidth="@dimen/dimension_2">

                            <FrameLayout
                                android:id="@+id/rlCharacter"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:elevation="@dimen/dimension_2" />

                        </com.google.android.material.card.MaterialCardView>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </quylh.canvas.shadow.ShadowLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constrain2"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_56"
            android:visibility="gone"
            android:elevation="@dimen/dimension_18"
            app:layout_constraintBottom_toTopOf="@+id/frame_rando_all"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/view17"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintDimensionRatio="3.6:0.08"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view18"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="3.6:0.08" />

            <ImageView
                android:id="@+id/btnFlip"
                android:layout_width="@dimen/dimension_0"

                android:layout_height="@dimen/dimension_0"
                android:layout_marginStart="@dimen/dimension_8"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_flip_all_custom"
                app:layout_constraintBottom_toTopOf="@+id/view18"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@+id/btnReset"
                app:layout_constraintTop_toBottomOf="@+id/view17"
                app:layout_constraintVertical_bias="1.0" />

            <ImageView
                android:id="@+id/btnReset"
                android:layout_width="@dimen/dimension_0"

                android:layout_height="@dimen/dimension_0"
                android:layout_marginStart="@dimen/dimension_16"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_reset_all_custom"
                app:layout_constraintBottom_toTopOf="@+id/view18"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view17"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialSmall"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_0"
            app:cardElevation="@dimen/dimension_18"
            app:cardCornerRadius="@dimen/dimension_3"
            app:cardBackgroundColor="@color/app_color7"
            android:layout_marginTop="@dimen/dimension_10"
            app:strokeColor="@color/app_color10"
            app:strokeWidth="@dimen/dimension_1_3"
            android:rotation="-5"
            app:layout_constraintDimensionRatio="8:9.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view15"
            app:layout_constraintBottom_toBottomOf="@id/view15">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="@dimen/dimension_18">




                    <ImageView
                        android:id="@+id/imvImage2"
                        android:layout_width="@dimen/dimension_0"
                        android:layout_height="@dimen/dimension_0"
                        android:background="@color/white"
                        app:layout_constraintDimensionRatio="1"
                        android:layout_margin="@dimen/dimension_5"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_permission"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/view14"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="3.6:0.08"
            app:layout_constraintTop_toTopOf="@+id/frame_rando_all" />
        <View
            android:id="@+id/view15"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintDimensionRatio="3.6:0.96"
            app:layout_constraintBottom_toBottomOf="@+id/view14" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frame_rando_all"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_48"
            app:layout_constraintBottom_toTopOf="@+id/frameLayer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/view4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintDimensionRatio="3.6:0.08"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimension_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="3.6:0.08" />


            <!-- Icon random -->


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llColor"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_1"
                app:layout_constraintBottom_toTopOf="@+id/view5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view4">


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardColor"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dimension_24"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="@dimen/dimension_0"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/transparent"
                    app:strokeWidth="@dimen/dimension_0">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/dimension_0">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcvColor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="5"
                            tools:listitem="@layout/item_color" />
                    </RelativeLayout>


                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frameLayer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintBottom_toTopOf="@+id/constraintNav"
            app:layout_constraintHeight_percent="0.265">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvPart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/dimension_20"
                android:elevation="@dimen/dimension_1"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:spanCount="5"
                tools:itemCount="40"
                tools:listitem="@layout/item_layer" />


        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintNav"
            android:layout_width="@dimen/dimension_0"
            android:layout_height="@dimen/dimension_56"
            android:background="@color/app_color4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvNav"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dimension_20"
                android:clipToPadding="false"
                android:elevation="@dimen/dimension_1"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:listitem="@layout/item_bottom_custom" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/imgShowBig"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
        android:elevation="@dimen/dimension_20"
            android:focusable="true"
            android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:layout_marginHorizontal="@dimen/dimension_16"
                android:layout_marginBottom="@dimen/dimension_82"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="2.4:2.88"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:cardBackgroundColor="@color/app_color7"
                    app:cardCornerRadius="@dimen/dimension_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/app_color10"
                    app:strokeWidth="@dimen/dimension_4">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
              >
                        <ImageView
                                android:id="@+id/imvImage"
                                android:layout_width="@dimen/dimension_0"
                                android:layout_height="@dimen/dimension_0"
                                android:elevation="@dimen/dimension_1"
                            android:layout_margin="@dimen/dimension_16"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintDimensionRatio="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_permission"/>

                    <TextView
                        android:id="@+id/tvPercent"
                        style="@style/single_marquee"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:elevation="@dimen/dimension_8"
                        android:focusable="true"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center_horizontal"
                        android:singleLine="true"
                        android:text="40%"

                        android:textColor="@color/app_color"
                        android:textSize="@dimen/text_size_18"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/imvImage"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="@dimen/dimension_40"
                android:layout_height="@dimen/dimension_40"
                android:layout_marginTop="@dimen/dimension_20"
                android:src="@drawable/ic_close_guide"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraint"/>


    </androidx.constraintlayout.widget.ConstraintLayout>



    <FrameLayout
            android:id="@+id/countDown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true"
        android:elevation="@dimen/dimension_30"
            android:focusableInTouchMode="true"
            android:visibility="gone">

        <TextView
                android:id="@+id/tvCountDown"
                android:layout_width="@dimen/dimension_50"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/baloo2_bold"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/app_color5"
                android:textSize="@dimen/text_size_50"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
