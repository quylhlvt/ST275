<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color4"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context="com.anime.oc.characters.avatar.ui.main.successcosplay.SuccessCosplayActivity">


    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar4" />
    </FrameLayout>


    <View
        android:id="@+id/view1"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dimension_0"
        android:layout_height="@dimen/dimension_0"
        android:id="@+id/material1"
        android:elevation="@dimen/dimension_5"
        app:cardElevation="@dimen/dimension_5"
        app:cardBackgroundColor="@color/app_color7"
        app:cardCornerRadius="@dimen/dimension_8"
        android:layout_marginVertical="@dimen/dimension_36"
        app:layout_constraintBottom_toBottomOf="@+id/view1"
        app:layout_constraintEnd_toEndOf="@+id/view1"
        app:layout_constraintStart_toStartOf="@+id/view1"
        app:layout_constraintDimensionRatio="2.4:2.88"
        app:layout_constraintTop_toTopOf="@+id/view1"
        app:strokeColor="@color/app_color10"
        app:strokeWidth="@dimen/dimension_4">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_1"
                android:layout_margin="@dimen/dimension_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="1"
                android:scaleType="centerCrop"
                android:src="@drawable/img_permission"/>

            <ImageView
                android:id="@+id/img_level"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1.4:0.44"
                android:layout_marginVertical="@dimen/dimension_10"
                android:elevation="@dimen/dimension_8"
                android:src="@drawable/img_level1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imvImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


    <ImageView
        android:id="@+id/constraintLayout2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimension_0"
        android:layout_marginTop="@dimen/dimension_22"
        android:elevation="@dimen/dimension_3"
        android:background="@drawable/bg_win_effect"
        app:layout_constraintBottom_toBottomOf="@+id/material1"
        app:layout_constraintDimensionRatio="3.62:5.72"
        app:layout_constraintEnd_toEndOf="@+id/material1"
        app:layout_constraintStart_toStartOf="@+id/material1"
        app:layout_constraintTop_toTopOf="@+id/material1"/>



</androidx.constraintlayout.widget.ConstraintLayout>
