<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:background="@color/app_color4"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   tools:context="com.anime.oc.characters.avatar.ui.main.random.RandomActivity">


    <FrameLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

        <include
                android:id="@+id/actionBar"
                layout="@layout/layout_actionbar3"/>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/imgRandom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            android:layout_marginTop="@dimen/dimension_10"
            android:layout_marginHorizontal="@dimen/dimension_16"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutActionBar">
        <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                app:cardBackgroundColor="@color/app_color2"
                app:cardCornerRadius="@dimen/dimension_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/app_color5"
                app:strokeWidth="@dimen/dimension_2">
            <quylh.canvas.shadow.ShadowLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shadowBlur="@dimen/dimension_10"
                    app:shadowSpread="@dimen/dimension_0"
                    app:shadowMode="inner"
                    app:shadowColor="@color/white">
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_margin="@dimen/dimension_12"
                        android:layout_height="match_parent">
                    <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            app:cardBackgroundColor="@color/white"
                            app:strokeColor="@color/app_color5"
                            app:cardCornerRadius="@dimen/dimension_8"
                            app:strokeWidth="@dimen/dimension_2"
                            android:layout_height="match_parent">
                        <ImageView
                                android:elevation="@dimen/dimension_2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:id="@+id/imageGif"/>
                        <ImageView
                                android:elevation="@dimen/dimension_1"
                                android:id="@+id/imvImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_permission"/>

                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </quylh.canvas.shadow.ShadowLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lnlBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:layout_constraintVertical_bias="0"
            android:layout_marginTop="@dimen/dimension_40"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3.6:0.48"
            app:layout_constraintTop_toBottomOf="@+id/imgRandom">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/random"
                android:layout_width="@dimen/dimension_0"
                android:layout_height="@dimen/dimension_0"
                android:elevation="@dimen/dimension_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1.35:0.48"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            <ImageView
                    android:id="@+id/imgViewFor1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_frame_random"/>
            <ImageView
                    android:id="@+id/imgBtnRandom"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="4:2.4"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/dimension_8"
                    android:layout_marginVertical="@dimen/dimension_12"
                    android:src="@drawable/img_frame_btn_random"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                    android:id="@+id/txtRandom"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:fontFamily="@font/finger_paint_regular"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/dimension_10"
                    android:layout_marginStart="@dimen/dimension_1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imgBtnRandom"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:text="@string/random"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_16"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--        btnBottomRight-->

    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.anime.oc.characters.avatar.utils.BlockableFrameLayout
            android:id="@+id/flNativeCollab"
            android:elevation="100dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
