<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false"
        android:layout_marginBottom="@dimen/dimension_8">
    <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_0"
            app:gslCornerRadius="@dimen/dimension_18_"
            app:gslStrokeWidth="@dimen/dimension_2"
            app:gslStartColor="@color/app_color"
            app:gslCenterColor="@color/app_color"
            app:gslEndColor="@color/app_color"
            android:elevation="@dimen/dimension_20"
            app:layout_constraintDimensionRatio="3.28:0.56"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/flMain"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black3"
            />
            <View
                    android:id="@+id/top5"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.28:0.06"
                    app:layout_constraintTop_toTopOf="parent"/>

            <View
                    android:id="@+id/top20"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.28:0.18"
                    app:layout_constraintTop_toTopOf="parent"/>

            <View
                    android:id="@+id/top16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintDimensionRatio="3.28:0.14"
                    app:layout_constraintTop_toTopOf="parent"/>

            <View
                    android:id="@+id/bottom6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="3.28:0.06"/>
            <View
                    android:id="@+id/bottom20"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="3.28:0.18"/>

            <View
                    android:id="@+id/bottom16"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimension_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="3.28:0.14"/>

            <com.quylh.gradientstrokelayout.GradientStrokeFrameLayout
                    android:layout_width="match_parent"
                    android:id="@+id/imgLangFor"
                    android:layout_marginBottom="@dimen/dimension_4"
                    android:layout_height="match_parent"
                    app:gslStrokeWidth="@dimen/dimension_0"
                    app:gslCornerRadius="@dimen/dimension_17_">
                <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                />
            </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>

            <ImageView
                    android:id="@+id/imvFlag"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginStart="@dimen/dimension_12"
                    android:src="@drawable/ic_flag_english"
                    app:layout_constraintBottom_toTopOf="@+id/bottom16"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="@+id/imgLangFor"
                    app:layout_constraintTop_toBottomOf="@+id/top16"/>

            <ImageView
                    android:id="@+id/btnRadio"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="@dimen/dimension_0"
                    android:layout_marginEnd="@dimen/dimension_16"
                    android:src="@drawable/ic_select_lang"
                    app:layout_constraintBottom_toTopOf="@+id/bottom20"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="@+id/imgLangFor"
                    app:layout_constraintTop_toBottomOf="@+id/top20"/>

            <TextView
                    android:id="@+id/tvLang"
                    style="@style/single_marquee"
                    android:layout_width="@dimen/dimension_0"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/top16"
                    app:layout_constraintBottom_toTopOf="@+id/bottom16"
                    android:layout_marginStart="@dimen/dimension_16"
                    android:fontFamily="@font/finger_paint_regular"
                    android:gravity="start|center_vertical"
                    android:text="@string/language"
                    android:textColor="@color/app_color"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintEnd_toStartOf="@+id/btnRadio"
                    app:layout_constraintStart_toEndOf="@+id/imvFlag"
                   />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.quylh.gradientstrokelayout.GradientStrokeFrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
